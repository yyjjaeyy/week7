<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="ToggleButton 실습"
        android:textColor="#8BC34A"
        android:textSize="18sp"
        android:textStyle="bold|italic" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <ImageView
            android:id="@+id/iv_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="방"
            android:scaleType="fitXY"
            android:src="@drawable/bg1" />

        <ImageView
            android:id="@+id/iv_light1"
            android:layout_width="40dp"
            android:layout_height="100dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="140dp"
            android:contentDescription="조명1"
            android:scaleType="fitCenter"
            android:src="@drawable/light11" />

        <ImageView
            android:id="@+id/iv_light2"
            android:layout_width="40dp"
            android:layout_height="100dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="180dp"
            android:layout_marginTop="20dp"
            android:contentDescription="조명2"
            android:scaleType="fitCenter"
            android:src="@drawable/light12" />

        <ImageView
            android:id="@+id/iv_light3"
            android:layout_width="40dp"
            android:layout_height="100dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="220dp"
            android:contentDescription="조명3"
            android:scaleType="fitCenter"
            android:src="@drawable/light13" />

        <ToggleButton
            android:id="@+id/tb_light"
            android:layout_width="24dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="110dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/toggle_switch"
            android:text=""
            android:textOff=""
            android:textOn="" />
    </FrameLayout>

</LinearLayout>