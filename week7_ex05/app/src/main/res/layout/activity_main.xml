<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Switch 실습"
        android:textColor="#8BC34A"
        android:textSize="18sp"
        android:textStyle="bold|italic" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="창문"
            android:scaleType="fitXY"
            android:src="@drawable/window" />

        <!-- 조명 꺼졌을 때 어둡게 덮는 반투명 막 -->
        <View
            android:id="@+id/v_dark"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#88000000" />

        <ImageView
            android:id="@+id/iv_lamp"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:contentDescription="램프"
            android:scaleType="fitCenter"
            android:src="@drawable/light31" />

        <ImageView
            android:id="@+id/iv_cat"
            android:layout_width="110dp"
            android:layout_height="90dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginStart="30dp"
            android:layout_marginBottom="10dp"
            android:contentDescription="고양이"
            android:scaleType="fitCenter"
            android:src="@drawable/cat5"
            android:visibility="invisible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Switch
            android:id="@+id/sw_cat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:text="고양이" />

        <Switch
            android:id="@+id/sw_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="라이트" />
    </LinearLayout>

</LinearLayout>